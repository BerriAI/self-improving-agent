{
  "name": "self-improving-agent",
  "version": "0.5.0",
  "description": "Drop-in self-improvement loop for any AI agent. Two tools + a skill. The agent proposes a diff, the human approves, a draft PR opens.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "self-improving",
    "feedback",
    "llm",
    "tool",
    "github",
    "pr",
    "skill"
  ],
  "author": "BerriAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BerriAI/self-improving-agent.git"
  },
  "homepage": "https://github.com/BerriAI/self-improving-agent#readme",
  "bugs": {
    "url": "https://github.com/BerriAI/self-improving-agent/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.2.0",
    "@mariozechner/pi-agent-core": ">=0.7.0",
    "typebox": ">=1.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@mariozechner/pi-agent-core": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.128",
    "@mariozechner/pi-agent-core": "^0.73.0",
    "@types/node": "^20.0.0",
    "typebox": "^1.1.37",
    "typescript": "^5.5.0",
    "zod": "^4.4.3"
  }
}
